allow vendor_init tmpfs:dir create_dir_perms;

allow vendor_init cgroup:file rw_file_perms;

allow vendor_init block_device:lnk_file setattr;

allow vendor_init efs_file:dir rw_dir_perms;
allow vendor_init app_efs_file:dir search;
allow vendor_init app_efs_file:file { r_file_perms setattr };
allow vendor_init vendor_sysfs_digital_hall:file w_file_perms;
allow vendor_init spen_efs_file:dir create_dir_perms;

allow vendor_init vendor_ssr_prop:property_service set;

# Allow vendor_init to set vendor_thermal_prop properties
allow vendor_init vendor_thermal_prop:property_service set;

# Camera provider init scripts initialize UniHAL and worker scheduling properties.
set_prop(vendor_init, vendor_camera_prop)
